{
  "manifest_version": 3,
  "name": "Viva Card Privacy Guard",
  "version": "1.0.0",
  "description": "Automatically unchecks the 'Remember this card' box on Viva Wallet payment pages, so your card details are never saved without your explicit consent.",
  "author": "John Ntirintis",
  "homepage_url": "https://github.com/JohnNtirintis/viva-card-privacy-guard",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pay.vivapayments.com/*",
        "https://demo.vivapayments.com/*",
        "https://*.vivapayments.com/*",
        "https://*.vfrm.me/*",
        "https://*.vivawallet.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "109.0"
    }
  }
}
